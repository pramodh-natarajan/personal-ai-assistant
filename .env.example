# ==========================================
# Bodhi Personal AI Assistant Environment Setup
# ==========================================

# 1. LLM Endpoint Credentials
# Required for model inference via OpenRouter (Hermes-3 / Llama 3.1 405B)
OPENROUTER_API_KEY=sk-or-v1-your-actual-openrouter-key-here

# 2. Access Control & Security
# Whitelisted phone number in E.164 format allowed to trigger Bodhi via WhatsApp
ALLOWED_WHATSAPP_NUMBER=+19999999999

# 3. GitHub State Persistence (Replaces Google Drive / rclone)
# Fine-grained GitHub Personal Access Token (github_pat_...) with Read/Write access to contents
GITHUB_TOKEN=github_pat_11AAAAAAA_your_token_here

# Your GitHub username holding the private bodhi-state repository
GITHUB_USER=your-github-username

# The private repository name designated for saving memory snapshots (~/.hermes/)
BACKUP_REPO=bodhi-state

# 4. Gateway Runtime Settings
PORT=10000